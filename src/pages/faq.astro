---
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
import { b } from "../lib/baseUrl";

// 24 Qs sourced from real Google autocomplete + question-anchored expansions.
// Source: docs/seo-keywords-and-faq.md Section 2.
import { faqs } from "../data/faqs";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: site.url },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${site.url}/faq` },
  ],
};
---

<Layout
  title="HEIC FAQ — convert, open, view iPhone HEIC files explained"
  description={`Common questions about HEIC photos: how to convert to JPG or PNG, open on Windows, Android, Chromebook, send via WhatsApp, and more. Answered by ${site.name}.`}
  jsonLd={[jsonLd, breadcrumbLd]}
>
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <header class="mb-10">
      <p class="text-sm text-[var(--color-muted)] mb-2">
        <a href={b("/")} class="hover:text-[var(--color-fg)]">{site.name}</a>
        <span class="mx-1">/</span>
        <span>FAQ</span>
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
        HEIC frequently asked questions
      </h1>
      <p class="text-lg text-[var(--color-muted)]">
        Everything you might wonder about converting iPhone HEIC photos —
        sourced from real Google searches.
      </p>
    </header>

    <div class="space-y-8">
      {
        faqs.map((f) => (
          <article>
            <h2 class="text-xl font-bold mb-2 text-[var(--color-fg)]">
              {f.q}
            </h2>
            <p class="text-[var(--color-muted)] leading-relaxed">{f.a}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-16 p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] text-center">
      <p class="text-lg font-semibold mb-2">Ready to convert?</p>
      <p class="text-sm text-[var(--color-muted)] mb-4">
        Drop your iPhone HEIC photos and get JPGs or PNGs back instantly.
      </p>
      <a
        href={b("/")}
        class="inline-block px-6 py-3 rounded-lg bg-[var(--color-accent)] text-[var(--color-accent-fg)] font-semibold hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        Open the converter →
      </a>
    </div>
  </div>
</Layout>
